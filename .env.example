REDIS_PASSWORD=
JWT_SECRET=
NEXUSCHAT_GRPC_SHARED_SECRET=
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_USER=admin
CASSANDRA_PASSWORD=nexuschat165
CASSANDRA_KEYSPACE=NexusChat
USER_OAUTH_GOOGLE_CLIENTID=
USER_OAUTH_GOOGLE_CLIENTSECRET=
USER_OAUTH_GOOGLE_REDIRECTURL=http://localhost/api/user/oauth2/google/callback
USER_AUTH_COOKIE_DOMAIN=
USER_AUTH_COOKIE_SECURE=false
USER_AUTH_COOKIE_SAMESITE=lax
USER_OAUTH_COOKIE_DOMAIN=
USER_OAUTH_COOKIE_SECURE=false
USER_OAUTH_COOKIE_SAMESITE=lax
SAFETY_WARN_SCORE=40
SAFETY_BLOCK_SCORE=70
SAFETY_RATE_LIMIT_WINDOWSECOND=10
SAFETY_RATE_LIMIT_MAXMESSAGES=12
SAFETY_RATE_LIMIT_MUTESECOND=30
DISCOVERY_CANDIDATELIMIT=20
DISCOVERY_RECENTPEERDAY=7
WORKSPACE_REMINDERPOLLSECOND=15
# Internal gRPC security. Keep TLS disabled for the default local Compose stack;
# enable it only after mounting a CA and mutual client/server certificates.
NEXUSCHAT_GRPC_ASSERTION_KEY_ID=default
NEXUSCHAT_GRPC_ASSERTION_PRIVATE_KEY=
NEXUSCHAT_GRPC_ASSERTION_PUBLIC_KEY=
NEXUSCHAT_GRPC_TLS_ENABLED=false
NEXUSCHAT_GRPC_TLS_CA_FILE=/run/secrets/grpc/ca.crt
NEXUSCHAT_GRPC_TLS_CLIENT_CERT_FILE=/run/secrets/grpc/client.crt
NEXUSCHAT_GRPC_TLS_CLIENT_KEY_FILE=/run/secrets/grpc/client.key
NEXUSCHAT_GRPC_TLS_SERVER_CERT_FILE=/run/secrets/grpc/server.crt
NEXUSCHAT_GRPC_TLS_SERVER_KEY_FILE=/run/secrets/grpc/server.key
NEXUSCHAT_GRPC_TLS_SERVER_NAME=localhost
