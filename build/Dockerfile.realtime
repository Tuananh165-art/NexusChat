FROM golang:1.25.12 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG SERVICE
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-X github.com/Tuananh165-art/NexusChat/cmd.Version=${VERSION} -w -s" -o server ./main.go

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/server /app/server
USER 10001:10001
ARG SERVICE
ENV NEXUSCHAT_SERVICE=${SERVICE}
ENTRYPOINT ["/app/server"]
