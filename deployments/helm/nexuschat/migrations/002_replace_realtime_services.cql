USE "NexusChat";
DROP TABLE IF EXISTS notifications_by_user;
DROP TABLE IF EXISTS push_subscriptions_by_user;
DROP TABLE IF EXISTS notification_preferences;
DROP TABLE IF EXISTS calls_by_user;
DROP TABLE IF EXISTS calls_by_channel;

CREATE TABLE IF NOT EXISTS safety_rules (rule_id text PRIMARY KEY, name text, pattern text, score int, enabled boolean, created_at timestamp, updated_at timestamp);
CREATE TABLE IF NOT EXISTS safety_reports_by_id (report_id text PRIMARY KEY, reporter_id bigint, target_user_id bigint, channel_id bigint, message_id bigint, reason text, details text, status text, created_at timestamp, updated_at timestamp);
CREATE TABLE IF NOT EXISTS safety_reports_by_status (status text, created_at timestamp, report_id text, reporter_id bigint, target_user_id bigint, channel_id bigint, message_id bigint, reason text, PRIMARY KEY ((status), created_at, report_id));
CREATE TABLE IF NOT EXISTS safety_blocks_by_user (user_id bigint, blocked_user_id bigint, created_at timestamp, PRIMARY KEY (user_id, blocked_user_id));
CREATE TABLE IF NOT EXISTS safety_decisions_by_channel (channel_id bigint, created_at timestamp, decision_id text, message_id bigint, user_id bigint, score int, action text, reason text, PRIMARY KEY ((channel_id), created_at, decision_id));
CREATE TABLE IF NOT EXISTS safety_decisions_by_user (user_id bigint, created_at timestamp, decision_id text, channel_id bigint, message_id bigint, score int, action text, reason text, PRIMARY KEY ((user_id), created_at, decision_id));
CREATE TABLE IF NOT EXISTS safety_appeals_by_report (report_id text, created_at timestamp, appeal_id text, user_id bigint, reason text, status text, PRIMARY KEY ((report_id), created_at, appeal_id));
CREATE TABLE IF NOT EXISTS user_risk_snapshots (user_id bigint PRIMARY KEY, score int, reason text, updated_at timestamp);
CREATE TABLE IF NOT EXISTS discovery_profiles_by_user (user_id bigint PRIMARY KEY, languages text, interests text, avoid_topics text, conversation_goal text, enabled boolean, updated_at timestamp);
CREATE TABLE IF NOT EXISTS discovery_feedback_by_user (user_id bigint, created_at timestamp, feedback_id text, peer_id bigint, channel_id bigint, rating int, tags text, comment text, updated_at timestamp, PRIMARY KEY ((user_id), created_at, feedback_id));
CREATE TABLE IF NOT EXISTS discovery_matches_by_user (user_id bigint, matched_at timestamp, match_id text, peer_id bigint, channel_id bigint, score double, PRIMARY KEY ((user_id), matched_at, match_id));
CREATE TABLE IF NOT EXISTS workspace_items_by_channel (channel_id bigint, updated_at timestamp, item_id text, owner_id bigint, kind text, title text, content text, status text, priority text, assignees text, tags set<text>, message_id bigint, due_at timestamp, created_at timestamp, PRIMARY KEY ((channel_id), updated_at, item_id));
CREATE TABLE IF NOT EXISTS workspace_items_by_id (item_id text PRIMARY KEY, channel_id bigint, updated_at timestamp, owner_id bigint, kind text, title text, content text, status text, priority text, assignees text, tags set<text>, message_id bigint, due_at timestamp, created_at timestamp);
CREATE TABLE IF NOT EXISTS workspace_bookmarks_by_user (user_id bigint, created_at timestamp, item_id text, channel_id bigint, title text, tags set<text>, PRIMARY KEY ((user_id), created_at, item_id));
CREATE TABLE IF NOT EXISTS workspace_collections_by_user (user_id bigint, collection_id text, name text, created_at timestamp, updated_at timestamp, PRIMARY KEY (user_id, collection_id));
CREATE TABLE IF NOT EXISTS workspace_checklists_by_item (item_id text, checklist_id text, text text, done boolean, created_at timestamp, updated_at timestamp, PRIMARY KEY (item_id, checklist_id));
